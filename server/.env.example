# Server
NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/gyanexia?retryWrites=true&w=majority

# Authentication: use a long, random value (at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin; separate multiple origins with commas when needed.
CLIENT_ORIGIN=https://your-vercel-project.vercel.app

# Server-only integrations. Never add these values to the frontend environment.
RAZORPAY_KEY_ID=rzp_test_or_live_public_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
GEMINI_API_KEY=your_gemini_api_key
