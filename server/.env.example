# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/gyanexia?retryWrites=true&w=majority

# Authentication: use a long, random value (at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# React app origin; separate multiple origins with commas
CLIENT_ORIGIN=http://localhost:3000
